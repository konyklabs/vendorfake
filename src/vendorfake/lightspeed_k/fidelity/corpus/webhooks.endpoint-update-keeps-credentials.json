{
  "schema": 1,
  "id": "webhooks.endpoint-update-keeps-credentials",
  "title": "A webhook endpoint created with Basic credentials keeps them through an update that omits them",
  "source": {
    "url": "https://api-docs.lsk.lightspeed.app/source.json",
    "fetched": "2026-10-29",
    "provenance": "judgment",
    "note": "The document names a reset on update for three flags only; that withBasicAuth, username and password are kept from the stored endpoint when an update omits them is this unit's reading."
  },
  "routes": [
    "PUT /o/wh/1/webhook",
    "POST /o/wh/1/webhook",
    "GET /o/wh/1/webhook/{endpointId}"
  ],
  "profile": "full",
  "steps": [
    {
      "name": "create with Basic",
      "request": {
        "method": "PUT",
        "path": "/o/wh/1/webhook",
        "headers": {"authorization": "bearer ${vars.access_token}"},
        "body": {
          "endpointId": "${vars.endpoint_id}",
          "url": "${vars.webhook_url}",
          "withBasicAuth": true,
          "username": "${vars.basic_user}",
          "password": "${vars.basic_password}"
        }
      },
      "expect": {"status": 200, "body": {"withBasicAuth": true, "username": "${vars.basic_user}"}}
    },
    {
      "name": "update without the credentials",
      "request": {
        "method": "POST",
        "path": "/o/wh/1/webhook",
        "headers": {"authorization": "bearer ${vars.access_token}"},
        "body": {"endpointId": "${vars.endpoint_id}", "url": "${vars.webhook_url}"}
      },
      "expect": {
        "status": 200,
        "body": {
          "endpointId": "${vars.endpoint_id}",
          "withBasicAuth": true,
          "username": "${vars.basic_user}",
          "password": "${vars.basic_password}"
        }
      }
    },
    {
      "name": "read it back",
      "request": {
        "method": "GET",
        "path": "/o/wh/1/webhook/${vars.endpoint_id}",
        "headers": {"authorization": "bearer ${vars.access_token}"}
      },
      "expect": {
        "status": 200,
        "body": {
          "endpointId": "${vars.endpoint_id}",
          "withBasicAuth": true,
          "username": "${vars.basic_user}",
          "password": "${vars.basic_password}"
        }
      }
    }
  ]
}
